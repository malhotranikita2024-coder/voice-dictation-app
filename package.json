{
  "name": "voice-dictation-app",
  "version": "0.1.0",
  "description": "",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "echo \"Error: no test specified\" && exit 1",
    "test:db": "node scripts/test-db-connection.js",
    "dist": "electron-builder --win --dir",
    "dist:installer": "electron-builder --win"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "build": {
    "appId": "com.ramble.app",
    "productName": "Ramble",
    "extraMetadata": {
      "name": "ramble"
    },
    "npmRebuild": false,
    "artifactName": "${productName}-Setup.exe",
    "files": [
      "**/*",
      "!.env",
      "!.env.example",
      "!.git${/*}",
      "!.claude${/*}",
      "!dist${/*}",
      "!PROJECT_NOTES.md",
      "!README.md"
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "directories": {
      "output": "dist"
    }
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "electron-store": "^8.2.0",
    "get-windows": "^9.3.0",
    "groq-sdk": "^1.5.0",
    "keysender": "^2.4.0",
    "mongodb": "^7.5.0",
    "uiohook-napi": "^1.5.5",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3"
  }
}
